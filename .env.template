# Outclaw Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# REQUIRED: Azure App Registration
# ============================================

# Your Azure app's Application (client) ID
# Get from: Azure Portal > App registrations > Your app > Overview
OUTCLAW_CLIENT_ID=

# Your Azure app's client secret
# Get from: Azure Portal > App registrations > Your app > Certificates & secrets
OUTCLAW_CLIENT_SECRET=

# ============================================
# OPTIONAL: Defaults work for most users
# ============================================

# Redirect URI - must match your Azure app registration
# Default: http://localhost:8000/callback
# OUTCLAW_REDIRECT_URI=http://localhost:8000/callback

# Tenant ID
# "consumers" = personal Microsoft accounts (Outlook.com, Hotmail, Live)
# "common" = personal + work/school accounts
# Default: consumers
# OUTCLAW_TENANT_ID=consumers

# API Scopes (space-separated)
# Default: Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Tasks.ReadWrite
# OUTCLAW_SCOPES=Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Tasks.ReadWrite

# ============================================
# ADVANCED: Usually don't need to change
# ============================================

# Graph API endpoint
# OUTCLAW_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# Token storage directory (relative to home)
# OUTCLAW_TOKEN_CACHE_DIR=.outclaw

# Use system keyring for token storage (true/false)
# OUTCLAW_USE_KEYRING=true

# Token refresh threshold (seconds before expiry)
# OUTCLAW_TOKEN_REFRESH_THRESHOLD=300

# Request timeout (seconds)
# OUTCLAW_REQUEST_TIMEOUT=30

# Max retries for failed requests
# OUTCLAW_MAX_RETRIES=3
